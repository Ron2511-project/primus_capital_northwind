# PostgreSQL
POSTGRES_USER=northwind
POSTGRES_PASSWORD=northwind_secret
POSTGRES_DB=northwind_collections
POSTGRES_PORT=5432

# API
API_PORT=8080
DATABASE_URL=postgres://northwind:northwind_secret@postgres:5432/northwind_collections?sslmode=disable
CORS_ORIGIN=http://localhost:5173
SEED_ON_START=true

# Frontend (build-time / dev)
VITE_API_URL=http://localhost:8080
